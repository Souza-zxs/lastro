# Supabase — rode `supabase start` e pegue os valores locais em `supabase status`,
# ou copie do painel do projeto (Project Settings > API) em produção.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Origem pública do site, usada para montar a URL de verificação no QR code
# do certificado (ex.: https://lastro.app em produção).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Segredo compartilhado com o agendador (Vercel Cron) para autorizar a
# chamada de /api/jobs/monitorar. Gere um valor aleatório qualquer.
CRON_SECRET=

# API key do Google Cloud Vision (Web Detection), usada pelo monitoramento
# de uso indevido para buscar cópias das imagens registradas na web.
# Criar em: console.cloud.google.com > APIs & Services > Credentials,
# com a Cloud Vision API habilitada no projeto.
GOOGLE_VISION_API_KEY=

# Resend (resend.com), usado para o e-mail de resumo do monitoramento de
# uso indevido. Sem essas duas variáveis, o job simplesmente não manda
# e-mail (não quebra nada). RESEND_FROM_EMAIL precisa ser de um domínio
# verificado no Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Asaas (asaas.com), usado para gerar as cobranças do checkout de pacotes
# de créditos. ASAAS_API_KEY é a chave da conta (Configurações >
# Integrações > API); ASAAS_ENV controla qual ambiente é usado
# ("sandbox" ou "production" — qualquer outro valor cai em sandbox).
# ASAAS_WEBHOOK_TOKEN é um valor aleatório seu, configurado também no
# painel do Asaas em Integrações > Webhooks (campo "Token de
# autenticação") — o Asaas devolve esse mesmo token no header
# `asaas-access-token` de toda notificação, o que autentica
# /api/webhooks/asaas.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# Greenn (greenn.com.br), gateway que substitui o Asaas no checkout de
# assinatura dos planos (lib/planos.ts — Essencial/Estúdio/Portfólio, cada
# um com checkout hospedado pré-criado no painel da Greenn, um link por
# ciclo mensal/semestral/anual). GREENN_API_KEY e GREENN_PUBLIC_KEY vêm do
# painel da Greenn (Integrações) e ainda não são usadas no código (os
# checkouts são links hospedados prontos, não criados via API).
#
# GREENN_WEBHOOK_TOKEN autentica /api/webhooks/greenn: a Greenn não tem
# campo de token/assinatura no painel, só a "URL do Webhook" (Produtos >
# editar produto > Conteúdos > Adicionar Conteúdo > Sistema Externo >
# Webhook, escolher Vendas ou Assinatura). Gere um valor aleatório aqui e
# cadastre a MESMA URL com esse token na query string em cada um dos 9
# produtos/ciclos:
#   https://<seu-dominio>/api/webhooks/greenn?token=<GREENN_WEBHOOK_TOKEN>
GREENN_API_KEY=
GREENN_PUBLIC_KEY=
GREENN_WEBHOOK_TOKEN=

# Web Push (notificação do PWA sobre atualização de processo do INPI).
# Gere um par com `npx web-push generate-vapid-keys`. NEXT_PUBLIC_VAPID_PUBLIC_KEY
# vai pro navegador (não é segredo); VAPID_PRIVATE_KEY fica só no servidor.
# VAPID_SUBJECT é um "mailto:" ou URL de contato, exigido pelo protocolo Web Push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
